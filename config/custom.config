# 25.12 test configuration intent, merged on top of
# defconfig/mt7981-ax3000.config from chasey-dev/immortalwrt-mt798x-rebase.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-112m-nmbm=y
CONFIG_PACKAGE_luci-app-homeproxy=y

# The test image must not expose UPnP on a private/CGNAT WAN.
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd is not set

# On-demand diagnostics. These consume flash only when idle and do not add
# resident daemons.
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_iperf3=y
