# Long-lived configuration intent, merged on top of defconfig/mt7981-ax3000.config.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-ubootmod=y
CONFIG_PACKAGE_luci-app-homeproxy=y

# On-demand diagnostics. These consume flash only when idle and do not add
# resident daemons.
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_iperf3=y
